# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Pytest / Unit Test Cache
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Generated Output Documents & SQLite DB
output/*
!output/.gitkeep
data/*.db

# Operating System & IDE Artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Node.js & Playwright Test Artifacts
node_modules/
test-results/
playwright-report/
tests/e2e/playwright-report/
.last-run.json
