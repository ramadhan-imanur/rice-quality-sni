# ==============================================================================
# .env.example — Konfigurasi Lingkungan Produksi Sistem Taksasi Mutu Beras
# Standar Acuan: SNI 6128:2020, Bapanas No. 67/2024, UU PDP No. 27/2022
# ==============================================================================

# 1. Konfigurasi Jaringan & Peladen Web (Python Stdlib HTTP Server)
PORT=8000
ENVIRONMENT=production

# 2. Kunci Rahasia Kriptografi (HMAC-SHA256 & Session Tokens)
# CATATAN: Wajib diisi dengan kunci acak 32-byte (64 karakter heksadesimal) di lingkungan produksi!
# Contoh generasi kunci: python3 -c "import secrets; print(secrets.token_hex(32))"
SNI_SECRET_KEY=e8f3b2a1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8b7c6d5e4f3

# 3. Direktori Penyimpanan Lokal (Offline-First Storage)
OUTPUT_DIR=output
DATA_DIR=data
DATABASE_PATH=data/rice_quality.db

# 4. Batas Keamanan & Pelindung Beban Berlebih (DoS & CWE Mitigations)
MAX_PAYLOAD_SIZE=15728640
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60

# 5. Integrasi Opsional Cloud Supabase (Jika Mengaktifkan Replikasi Hybrid)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
